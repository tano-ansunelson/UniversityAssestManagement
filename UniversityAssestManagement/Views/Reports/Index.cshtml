@model UniversityAssestManagement.Models.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
    ViewData["ActivePage"] = "Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Reports</h1>
        <p class="page-subtitle">Comprehensive analytics and asset reporting across all colleges.</p>
    </div>
    <a asp-action="ExportPdf"
       asp-controller="Reports"
       class="btn-primary">

        <svg xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke="currentColor"
             stroke-width="2">
            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>

        Export PDF
    </a>
  @*   <button class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        Export PDF
    </button> *@
</div>

<!-- Summary Stats -->
<div class="stats-grid" style="margin-bottom:28px">
    <div class="stat-card c-gold">
        <div class="stat-icon si-gold">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalAssetValue.ToString("C")</div>
            <div class="stat-label">Total Asset Value</div>
        </div>
    </div>

    <div class="stat-card c-blue">
        <div class="stat-icon si-blue">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M9 21V9m6 12V9M3 9l9-6 9 6" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.MostActiveCollege</div>
            <div class="stat-label">Most Active College</div>
            <div class="stat-meta">@Model.MostActiveCount total assets</div>
        </div>
    </div>

    <div class="stat-card c-rose">
        <div class="stat-icon si-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalDamaged</div>
            <div class="stat-label">Total Damaged</div>
            <div class="stat-meta">Across all colleges</div>
        </div>
    </div>
</div>

<!-- Two-column: Assets by College + Damaged Assets -->
<div class="grid-2" style="margin-bottom:22px">

    <!-- Assets by College -->
    <div class="panel">
        <div class="panel-header">
            <div>
                <div class="panel-title">Assets by College</div>
                <div class="panel-subtitle">Distribution of assets across colleges</div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>College</th>
                        <th>Total</th>
                        <th>Active</th>
                        <th>Damaged</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var row in Model.AssetByCollege)
                    {
                        <tr>
                            <td class="td-name">@row.College</td>
                            <td class="td-muted">@row.Total</td>
                            <td class="td-success">@row.Active</td>
                            <td class="td-danger">@row.Damaged</td>
                        </tr>
                    }
                
                </tbody>
                <tfoot>
                    <tr>
                        <td>Total</td>
                        <td>@Model.GrandTotal</td>
                        <td style="color:var(--teal)">@Model.GrandActive</td>
                        <td style="color:var(--rose)">@Model.GrandDamaged</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Most Damaged Assets -->
    <div class="panel">
        <div class="panel-header">
            <div>
                <div class="panel-title">Most Damaged Assets</div>
                <div class="panel-subtitle">Assets requiring immediate attention</div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Asset</th>
                        <th>College</th>
                        <th>Severity</th>
                        <th>Reported</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var asset in Model.DamagedAssets)
                    {
                        <tr>
                            <td class="td-name">@asset.AssetName</td>
                            <td class="td-muted">@asset.CollegeName</td>
                            <td><span class="severity-@asset.Severity.ToLower()">@asset.Severity</span></td>
                            <td class="td-muted font-mono" style="font-size:12.5px">@asset.ReportedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                   
                 
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Asset Value by Type -->
<div class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Asset Value by Type</div>
            <div class="panel-subtitle">Breakdown of total asset value by category</div>
        </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;padding:22px">

        <div class="value-card">
            <div class="vc-label">Unique Assets</div>
            <div class="vc-amount">@Model.ValueBreakdown.UniqueValue.ToString("C")</div>
            <div class="progress-track" style="margin-top:10px;margin-bottom:8px">
                <div class="progress-fill" style="width:75%"></div>
            </div>
            <div class="vc-pct">@Model.ValueBreakdown.UniquePercent% of total portfolio</div>
        </div>

        <div class="value-card">
            <div class="vc-label">Bulk Assets</div>
            <div class="vc-amount">@Model.ValueBreakdown.BulkValue.ToString("C")</div>
            <div class="progress-track" style="margin-top:10px;margin-bottom:8px">
                <div class="progress-fill pf-gold" style="width:18%"></div>
            </div>
            <div class="vc-pct">@Model.ValueBreakdown.BulkPercent% of total portfolio</div>
        </div>

     

    </div>
</div>
