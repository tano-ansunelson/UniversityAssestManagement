@model UniversityAssetsManagement.Models.ViewModels.TechnicianViewModel.TechnicianListViewModel

@{
    ViewData["Title"] = "Technicians";
    ViewData["ActivePage"] = "Technicians";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Technicians</h1>
        <p class="page-subtitle">Manage technicians available for maintenance assignments.</p>
    </div>
    <a href="@Url.Action("Create", "Technicians")" class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add Technician
    </a>
</div>
 
@if (TempData["Success"] != null)
{
    <div class="alert-success" style="margin-bottom:20px">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        @TempData["Success"]
    </div>
}

<!-- Summary -->
<div class="stats-grid">
    <div class="stat-card c-blue">
        <div class="stat-icon si-blue">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.Technicians.Count</div>
            <div class="stat-label">Total Technicians</div>
        </div>
    </div>
    <div class="stat-card c-teal">
        <div class="stat-icon si-teal">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalActive</div>
            <div class="stat-label">Active</div>
        </div>
    </div>
    <div class="stat-card c-rose">
        <div class="stat-icon si-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalInactive</div>
            <div class="stat-label">Inactive</div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Technician Directory</div>
            <div class="panel-subtitle">All registered maintenance technicians</div>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Speciality</th>
                    <th>Jobs</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Technicians.Any())
                {
                    <tr>
                        <td colspan="7"
                            style="text-align:center;padding:32px;color:var(--text-muted)">
                            No technicians registered yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var tech in Model.Technicians)
                    {
                        <tr>
                            <td class="td-name">@tech.FullName</td>
                            <td class="td-muted font-mono"
                                style="font-size:12.5px">
                                @tech.Email
                            </td>
                            <td class="td-muted">@tech.PhoneNumber</td>
                            <td>
                                <span class="badge badge-navy">@tech.Speciality</span>
                            </td>
                            <td class="td-muted font-mono"
                                style="font-size:13px">
                                @tech.JobsAssigned
                            </td>
                            <td>
                                @if (tech.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactive</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex;gap:10px;align-items:center">
                                    <a href="@Url.Action("Edit", "Technicians",
                                                                                                                             new { id = tech.Id })"
                                       style="font-size:13px;font-weight:600;
                                        color:var(--sky);text-decoration:none">
                                        view
                                    </a>
                                    <a href="@Url.Action("Edit", "Technicians",
                                                                                                                                                                    new { id = tech.Id })"
                                       style="font-size:13px;font-weight:600;
                                        color:var(--sky);text-decoration:none">
                                        Edit
                                    </a>
                                    <form asp-action="ToggleActive"
                                          asp-controller="Technicians"
                                          method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@tech.Id" />
                                        <button type="submit"
                                                style="font-size:13px;font-weight:600;
                                            background:none;border:none;
                                            cursor:pointer;font-family:'DM Sans',sans-serif;
                                            color:@(tech.IsActive ? "var(--rose)" : "var(--teal)")">
                                            @(tech.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>