@model UniversityAssestManagement.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back — here's what's happening across all colleges today.</p>
    </div>
</div>

<!-- Stat Cards -->
<div class="stats-grid">
    <div class="stat-card c-blue">
        <div class="stat-icon si-blue">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0v10l-8 4-8-4V7" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalAssets</div>
            <div class="stat-label">Total Assets</div>
            <div class="stat-meta">Across all colleges</div>
        </div>
    </div>

    <div class="stat-card c-gold">
        <div class="stat-icon si-gold">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M9 21V9m6 12V9M3 9l9-6 9 6" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalColleges</div>
            <div class="stat-label">Total Colleges</div>
            <div class="stat-meta">Active institutions</div>
        </div>
    </div>

    <div class="stat-card c-rose">
        <div class="stat-icon si-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.DamagedAssets</div>
            <div class="stat-label">Damaged Assets</div>
            <div class="stat-meta">Needs attention</div>
        </div>
    </div>

    <div class="stat-card c-teal">
        <div class="stat-icon si-teal">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.UnderMaintenance</div>
            <div class="stat-label">Under Maintenance</div>
            <div class="stat-meta">Being serviced</div>
        </div>
    </div>
</div>

<!-- Bottom Grid: Recent Assets + College Distribution -->
<div class="grid-2">

    <!-- Recent Assets Table -->
    <div class="panel">
        <div class="panel-header">
            <div>
                <div class="panel-title">Recent Assets</div>
                <div class="panel-subtitle">Latest entries across the system</div>
            </div>
            <a asp-controller="Assets" asp-action="Index"  class="btn-ghost" style="width:auto;padding:6px 14px;font-size:12.5px">View all</a>
        </div>
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Asset Name</th>
                        <th>Type</th>
                        <th>College</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var asset in Model.RecentAssets)
                    {
                        <tr>
                            <td class="td-name">@asset.Name</td>
                            <td><span class="badge @(asset.Type==AssetType.Bulk? "badge-warning": "badge-navy")">@asset.Type</span></td>
                            <td class="td-muted">@asset.College.Name.Replace("College of", "")</td>
                            <td>
                                @if(asset.Status == AssetStatus.Active)
                                {
                                    <span class="badge badge-success">Active</span>
                                }else if (asset.Status == AssetStatus.Damaged)
                                {
                                    <span class="badge badge-danger">Damaged</span>
                                }else
                                {
                                    <span class="badge badge-warning">Under Maintenance</span>
                                }
 
                            </td>
                        </tr>
                    }

                   


                
                </tbody>
            </table>
        </div>
    </div>

    <!-- College Distribution -->
    <div class="panel">
        <div class="panel-header">
            <div>
                <div class="panel-title">Assets by College</div>
                <div class="panel-subtitle">Distribution overview</div>
            </div>
        </div>
        <div style="padding:20px 24px">
            @if (!Model.CollegeSummaries.Any())
            {
                <p style="color:var(--text-muted);font-size:13px">No data available.</p>
            }else
            {
                @foreach(var summary in Model.CollegeSummaries)
                {
                    <div class="progress-bar-wrap">
                        <div class="progress-label">
                            <span>@summary.College</span>
                            <span>@summary.Total</span>
                        </div>
                        <div class="progress-track">                           
                          <div class="progress-fill @GetBarColor(summary.BarPercentage)"
                              style="width:@(summary.BarPercentage)%"> 
                          </div>
                            
                      @* else if (summary.BarPercentage >= 65)
                            {
                                <div class="progress-fill pf-gold" style="width:@(summary.BarPercentage)%"> </div>
                            }
                            else if(summary.BarPercentage >= 45)
                            {
                                <div class="progress-fill pf-teal" style="width:@(summary.BarPercentage)%"> </div>
                            }
                            else
                            {
                                <div class="progress-fill pf-rose" style="width:@(summary.BarPercentage)%"> </div>
                            }
                            <p>@summary.BarPercentage</p> *@


                    
                            </div>
                    </div>

                }
            }

          

         
        </div>
    </div>

</div>

@functions {
    string GetBarColor(int percent) => percent switch
    {
        >= 70 => "",              // default navy
        >= 50 => "pf-gold",      // gold
        >= 30 => "pf-teal",      // teal
        _ => "pf-rose"       // rose
    };
}