@model UniversityAssestManagement.Models.ViewModels.CollegeUserListViewModel

@{
    ViewData["Title"] = "Manage College Users";
    ViewData["ActivePage"] = "ManageUsers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Manage College Users</h1>
        <p class="page-subtitle">Create and manage college administrator accounts.</p>
    </div>
    <a href="@Url.Action("Create", "ManageUsers")" class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add college user
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success" style="margin-bottom:20px">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="login-error" style="margin-bottom:20px">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        @TempData["Error"]
    </div>
}

<div class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">College Administrator Accounts</div>
            <div class="panel-subtitle">@Model.Users.Count account(s) registered</div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>College</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Created By</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="7"
                            style="text-align:center;padding:32px;color:var(--text-muted)">
                            No college users yet. Click "Add College User" to create one.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="td-name">@user.FullName</td>
                            <td class="td-muted">@user.Email</td>
                            <td>
                                <span class="badge badge-navy">@user.CollegeName</span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Disabled</span>
                                }
                            </td>
                            <td class="td-muted font-mono" style="font-size:12.5px">
                                @user.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td class="td-muted">@user.CreatedBy</td>
                            <td>
                                <div style="display:flex;gap:8px;align-items:center">


                                    <!-- Edit -->
                                    <a href="@Url.Action("Edit", "ManageUsers", new { id = user.Id })"
                                       style="font-size:13px;font-weight:600;
                                        color:var(--sky);text-decoration:none">
                                        Edit
                                    </a>

                                    <!-- Toggle Active -->
                                    <form asp-action="ToggleActive" asp-controller="ManageUsers"
                                          method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit"
                                                style="font-size:13px;font-weight:600;
                                            background:none;border:none;cursor:pointer;
                                            color:@(user.IsActive ? "var(--rose)" : "var(--teal)")">
                                            @(user.IsActive ? "Disable" : "Enable")
                                        </button>
                                    </form>


                                    <!-- Reset Password -->
                                    <button onclick="openResetModal('@user.Id','@user.FullName')"
                                            style="font-size:13px;font-weight:600;
                                        background:none;border:none;cursor:pointer;
                                        color:var(--amber)">
                                        Reset Password
                                    </button>


                                    <!-- Delete -->
                                    <button onclick="openDeleteModal('@user.Id', '@user.FullName', '@user.Email', '@user.CollegeName')"
                                            style="font-size:13px;font-weight:600;background:none;
                                        border:none;cursor:pointer;color:var(--rose);
                                        font-family:'DM Sans',sans-serif">
                                        Delete
                                    </button>


                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Reset Password Modal -->
<div id="resetModal"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);
    z-index:500;align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:var(--radius-lg);
        padding:32px;width:100%;max-width:400px;
        box-shadow:var(--shadow-lift);margin:24px">
        <h3 style="font-family:'Playfair Display',serif;font-size:18px;
            color:var(--navy);margin-bottom:6px">
            Reset Password
        </h3>
        <p id="resetModalName"
           style="font-size:13px;color:#7a8a9e;margin-bottom:20px"></p>

        <form asp-action="ResetPassword" asp-controller="ManageUsers" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="resetUserId" name="id" />

            <div style="margin-bottom:16px">
                <label class="field-label">New Password</label>
                <input type="password" name="newPassword" class="field-input"
                       placeholder="Enter new password" required minlength="6" />
            </div>

            <div style="display:flex;gap:10px">
                <button type="submit" class="btn-submit">Reset Password</button>
                <button type="button" class="btn-clear"
                        onclick="closeResetModal()">
                    Cancel
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ── Delete User Modal ── -->
<div class="modal-overlay" id="deleteUserModal"
     onclick="if(event.target===this) closeDeleteModal()">
    <div class="modal-box">

        <div class="modal-header">
            <h3>Delete College User</h3>
            <button type="button" class="modal-close" onclick="closeDeleteModal()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="modal-body">

            <!-- Warning banner -->
            <div style="display:flex;align-items:flex-start;gap:12px;
                padding:14px;margin-bottom:18px;
                background:rgba(224,92,107,.06);
                border:1.5px solid rgba(224,92,107,.2);
                border-radius:var(--radius-sm)">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2"
                     style="width:18px;height:18px;color:var(--rose);flex-shrink:0;margin-top:1px">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
                <div>
                    <p style="font-size:13.5px;font-weight:600;color:var(--navy);margin:0">
                        This action is permanent and cannot be undone.
                    </p>
                    <p style="font-size:12.5px;color:#7a8a9e;margin-top:3px">
                        The user will lose all access immediately.
                        Consider disabling the account instead if this is temporary.
                    </p>
                </div>
            </div>

            <!-- User summary -->
            <div style="display:flex;flex-direction:column;gap:0">
                <div style="display:flex;justify-content:space-between;
                    padding:11px 0;border-bottom:1px solid var(--cream-2)">
                    <span style="font-size:13px;color:#7a8a9e">Full Name</span>
                    <span id="dm-name"
                          style="font-size:13.5px;font-weight:600;color:var(--navy)"></span>
                </div>
                <div style="display:flex;justify-content:space-between;
                    padding:11px 0;border-bottom:1px solid var(--cream-2)">
                    <span style="font-size:13px;color:#7a8a9e">Email</span>
                    <span id="dm-email"
                          style="font-size:13px;font-family:'DM Mono',monospace;
                    color:#7a8a9e"></span>
                </div>
                <div style="display:flex;justify-content:space-between;padding:11px 0">
                    <span style="font-size:13px;color:#7a8a9e">College</span>
                    <span id="dm-college"
                          style="font-size:13.5px;color:var(--navy)"></span>
                </div>
            </div>

        </div>

        <div class="modal-footer">
            <form id="deleteUserForm"
                  asp-action="Delete" asp-controller="ManageUsers" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="dm-id" name="id" />
                <div style="display:flex;gap:10px">
                    <button type="submit" class="btn-submit btn-submit-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                        </svg>
                        Yes, Delete Account
                    </button>
                    <button type="button" class="btn-clear" onclick="closeDeleteModal()">
                        Cancel
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>





@section Scripts {
    <script>
        function openResetModal(id, name) {
            document.getElementById('resetUserId').value   = id;
            document.getElementById('resetModalName').textContent =
                `Resetting password for: ${name}`;
            document.getElementById('resetModal').style.display = 'flex';
        }

        function closeResetModal() {
            document.getElementById('resetModal').style.display = 'none';
        }

        // Close modal on backdrop click
        document.getElementById('resetModal').addEventListener('click', function(e) {
            if (e.target === this) closeResetModal();
        });




        //deleting functions

             function openDeleteModal(id, name, email, college) {
            document.getElementById('dm-id').value      = id;
            document.getElementById('dm-name').textContent    = name;
            document.getElementById('dm-email').textContent   = email;
            document.getElementById('dm-college').textContent = college;
            document.getElementById('deleteUserModal').classList.add('open');
        }

        function closeDeleteModal() {
            document.getElementById('deleteUserModal').classList.remove('open');
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeDeleteModal();
        });

        // existing reset modal scripts stay here too
        function openResetModal(id, name) {
            document.getElementById('resetUserId').value = id;
            document.getElementById('resetModalName').textContent =
                `Resetting password for: ${name}`;
            document.getElementById('resetModal').style.display = 'flex';
        }

        function closeResetModal() {
            document.getElementById('resetModal').style.display = 'none';
        }

        document.getElementById('resetModal')
            .addEventListener('click', function (e) {
                if (e.target === this) closeResetModal();
            });
    </script>
}