@model UniversityAssetsManagement.Models.ViewModels.UpdateMaintenanceViewModel

@{
    ViewData["Title"] = "Update Maintenance";
    ViewData["ActivePage"] = "Maintenance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <a href="@Url.Action("Index", "Maintenance")"
           style="font-size:13px;color:var(--text-muted);text-decoration:none;
            display:inline-flex;align-items:center;gap:5px;margin-bottom:8px">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Maintenance
        </a>
        <h1 class="page-title">Update Maintenance Record</h1>
        <p class="page-subtitle">
            @Model.AssetName &bull; @Model.CollegeName
        </p>
    </div>
</div>

<form asp-action="Update" asp-controller="Maintenance"
      method="post" style="max-width:680px">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <!-- Issue Summary — read only -->
    <div class="panel" style="margin-bottom:22px">
        <div class="panel-header">
            <div>
                <div class="panel-title">Issue Summary</div>
                <div class="panel-subtitle">
                    Reported on @Model.Date.ToString("dd MMM yyyy")
                </div>
            </div>
        </div>
        <div style="padding:18px 24px">
            <p style="font-size:13.5px;color:var(--navy);
                background:var(--cream);padding:12px 16px;
                border-radius:var(--radius-sm);margin:0">
                @Model.IssueDescription
            </p>
        </div>
    </div>

    <!-- Update form -->
    <div class="form-panel">
        <div class="form-panel-header">
            <h2>Maintenance Details</h2>
            <p>Update status, cost and technician information.</p>
        </div>
        <div class="form-panel-body">
            <div class="form-grid">

                <!-- Status -->
                <div>
                    <label class="field-label">
                        Status <span style="color:var(--rose)">*</span>
                    </label>
                    <select asp-for="Status" class="field-select"
                            onchange="toggleResolvedFields(this.value)">
                        @if (Model.Status == MaintenanceStatus.Fixed)
                        {
                            <option value="Fixed" selected>Fixed</option>
                            <option value="Pending">Pending</option>
                            <option value="Under Maintenance">Under Maintenance</option>
                        }
                        else if (Model.Status == MaintenanceStatus.UnderMaintenance)
                        {
                            <option value="Fixed">Fixed</option>
                            <option value="Pending">Pending</option>
                            <option value="Under Maintenance" selected>Under Maintenance</option>
                        }
                        else
                        {
                            <option value="Fixed">Fixed</option>
                            <option value="Pending" selected>Pending</option>
                            <option value="Under Maintenance">Under Maintenance</option>
                        }
                    </select>
                </div>

                <!-- Repair Cost -->
                <div>
                    <label class="field-label">Repair Cost (GHS)</label>
                    <input asp-for="Cost" type="number" step="0.01" min="0"
                           class="field-input" placeholder="0.00" />
                    <span asp-validation-for="Cost"
                          style="font-size:12px;color:var(--rose);
                    display:block;margin-top:4px"></span>
                </div>

                <!-- Technician -->
                <div class="full">
                    <label class="field-label">Technician Name</label>
                    <input asp-for="TechnicianName" class="field-input"
                           placeholder="e.g. John Mensah" />
                </div>
@* 
                <!-- Resolution Notes -->
                <div class="full">
                    <label class="field-label">Resolution Notes</label>
                    <textarea asp-for="ResolutionNotes" class="field-textarea"
                              placeholder="Describe what was done to fix the issue...">
                    </textarea>
                </div> *@

                <!-- Fixed banner — shown when status is Fixed -->
                <div class="full" id="fixedBanner"
                     style="display:@(Model.Status == MaintenanceStatus.Fixed ? "block" : "none")">
                    <div style="display:flex;align-items:center;gap:10px;
                        padding:12px 16px;
                        background:rgba(47,184,160,.08);
                        border:1.5px solid rgba(47,184,160,.25);
                        border-radius:var(--radius-sm)">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                             style="width:16px;height:16px;color:var(--teal);flex-shrink:0">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <p style="font-size:13px;color:#1a7a6a;margin:0">
                            Marking as <strong>Fixed</strong> will automatically
                            set the asset status back to <strong>Active</strong>.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div style="display:flex;gap:10px">
        <button type="submit" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
            </svg>
            Save Changes
        </button>
        <a href="@Url.Action("Index", "Maintenance")" class="btn-ghost"
           style="width:auto;padding:10px 20px">
            Cancel
        </a>
    </div>

</form>

@section Scripts {
    <script>
        function toggleResolvedFields(status) {
            const banner = document.getElementById('fixedBanner');
            banner.style.display = status === 'Fixed' ? 'block' : 'none';
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}