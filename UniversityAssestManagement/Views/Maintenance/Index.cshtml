@model UniversityAssestManagement.Models.ViewModels.MaintenanceViewModel

@{
    ViewData["Title"] = "Maintenance";
    ViewData["ActivePage"] = "Maintenance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["Success"] != null)
{
    <div class="alert-success" style="margin-bottom:20px">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="display:flex;align-items:center;gap:8px;padding:12px 16px;
        background:rgba(224,92,107,.08);border:1.5px solid rgba(224,92,107,.2);
        border-radius:var(--radius-sm);margin-bottom:20px;
        font-size:13.5px;color:var(--rose)">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2"
             style="width:16px;height:16px;flex-shrink:0">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        @TempData["Error"]
    </div>
}
<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Maintenance</h1>
        <p class="page-subtitle">Track and manage asset maintenance records across all colleges.</p>
    </div>
    @* <button class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Log Issue
    </button> *@
</div>

<!-- Summary Cards -->
<div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:28px">
    <div class="stat-card c-blue">
        <div class="stat-icon si-blue">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalRecords</div>
            <div class="stat-label">Total Records</div>
        </div>
    </div>

    <div class="stat-card c-rose">
        <div class="stat-icon si-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val" style="color:var(--rose)">@Model.PendingCount</div>
            <div class="stat-label">Pending</div>
        </div>
    </div>

    <div class="stat-card c-teal">
        <div class="stat-icon si-teal">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val" style="color:var(--teal)">@Model.FixedCount</div>
            <div class="stat-label">Fixed</div>
        </div>
    </div>

    <div class="stat-card c-gold">
        <div class="stat-icon si-gold">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalCost.ToString("C")</div>
            <div class="stat-label">Total Cost</div>
        </div>
    </div>
</div>

<!-- Maintenance Records Table -->
<div class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Maintenance Records</div>
            <div class="panel-subtitle">All maintenance activities and repairs</div>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Asset Name</th>
                    <th>Issue Description</th>
                    <th>College</th>
                    <th>Technician</th>
                    <th>Cost</th>
                    <th>Status</th>
                    <th>Resolved At</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Records.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center;padding:32px;color:var(--text-muted)">
                            No maintenance records found.
                        </td>
                    </tr>

                } else
                {
                    @foreach(var row in Model.Records)
                    {
                        <tr>
                            <td class="td-name">@row.AssetName</td>
                            <td class="td-muted">@row.IssueDescription</td>
                            <td class="td-muted">@row.CollegName</td>

                            <td class="td-muted">@(string.IsNullOrEmpty(row.TechnicianName) ? "-": row.TechnicianName)</td>
                            <td style="font-family:'DM Mono',monospace;font-size:13px">@row.Cost.ToString("C")</td>
                            <td>
                                @if(row.Status == MaintenanceStatus.Fixed)
                                {
                                    <span class="badge badge-success">Fixed</span>
                                }else if(row.Status == MaintenanceStatus.UnderMaintenance)
                                {
                                    <span class="badge badge-warning">Under Maintenance</span>
                                }else
                                {
                                    <span class="badge badge-danger">Pending</span>
                                }
                            </td>
                            <td class="td-muted font-mono" style="font-size:13px">@(row.ResolvedAt.HasValue ? row.ResolvedAt.Value.ToString("dd MMM yyyy") : "-" )</td>

                            <td>
                                <div style="display:flex;gap:10px;align-items:center">
                                    <a href="@Url.Action("Update", "Maintenance", new { id = row.Id })"
                                       style="font-size:13px;font-weight:600;color:var(--sky);text-decoration:none">
                                        Update
                                    </a>

                                    @if (row.Status == MaintenanceStatus.Pending ||
                                         row.Status == MaintenanceStatus.Assigned)
                                    {
                                        <a href="@Url.Action("Assign", "Maintenance", new { id = row.Id })"
                                           style="font-size:13px;font-weight:600;
                                            color:var(--teal);text-decoration:none">
                                            @(row.Status == MaintenanceStatus.Assigned
                                                ? "Reassign" : "Assign")
                                        </a>
                                    }
                                </div>
                            </td>


                       @*  <form asp-action="UpdateStatus" asp-controller="Maintenance" method="post"
                              style="display:inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@row.Id"/>
                            <select name="status"
                                    onchange="this.form.submit()"
                                    style="padding:6px 10px;border:1.5px solid var(--border-light);
                                           border-radius:var(--radius-sm);font-size:13px;
                                           font-family:'DM Sans',sans-serif;background:#fff;
                                           color:var(--navy);outline:none;cursor:pointer;">
                                <option value="" disabled selected>Update status</option>
                                        @if(row.Status == "Fixed")
                                            {
                                                <option value="Fixed" selected>Fixed</option>
                                                <option value="Pending">Pending</option>
                                                <option value="Under Maintenance">Under Maintenance</option>
                                            }else if(row.Status=="Pending")
                                            {
                                            <option value="Fixed">Fixed</option>
                                            <option value="Pending" selected>Pending</option>
                                            <option value="Under Maintenance">Under Maintenance</option>
                                            }
                                            else
                                            {
                                            <option value="Fixed">Fixed</option>
                                            <option value="Pending">Pending</option>
                                            <option value="Under Maintenance" selected>Under Maintenance</option>
                                            }
                                        </select>
                        </form> *@
                    
                        </tr>
                    }
                }

               
               
              
            </tbody>
        </table>
    </div>
    <div class="table-footer-bar">

        <p>
            Showing @Model.Records.Count of @Model.TotalRecords records
        </p>

        <div style="display:flex;align-items:center;gap:12px">

            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)">
                    ← Previous
                </a>
            }

            <span>
                Page @Model.CurrentPage of @Model.TotalPages
            </span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)">
                    Next →
                </a>
            }

        </div>

    </div>
</div>
