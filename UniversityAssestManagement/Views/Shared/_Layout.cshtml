<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – UAM</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/college-area.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @using Microsoft.AspNetCore.Identity
    @using UniversityAssestManagement.Models
    @inject UserManager<AppUser> UserManager

@{
        var currentUser = await UserManager.GetUserAsync(User);
        var FullName = currentUser?.FullName ?? "Super Admin";
        var email = currentUser?.Email ?? "superadmin@uam.com";
        // var collegeName = currentUser?.CollegeName ?? "College Portal";


        var initials = string.Concat(
            FullName.Split(' ')
                    .Where(w => w.Length > 0)
                    .Take(2)
                    .Select(w => w[0].ToString().ToUpper())
        );
    }

    <!-- ── Sidebar Overlay (mobile) ── -->
    <div class="sidebar-overlay" id="overlay" onclick="toggleSidebar()"></div>

    <!-- ── Mobile Toggle ── -->
    <button class="sidebar-toggle" onclick="toggleSidebar()" aria-label="Toggle navigation">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
    </button>

    <!-- ── Sidebar ── -->
    <aside class="sidebar" id="sidebar">

        <!-- Brand -->
        <div class="sidebar-brand">
            <div class="brand-mark">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0v10l-8 4-8-4V7" />
                </svg>
            </div>
            <div class="brand-text">
                <div class="brand-name">Asset Management</div>
                <div class="brand-sub">University System</div>
            </div>
        </div>

        <!-- Navigation -->
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="Dashboard" asp-action="Index" class="@(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    </svg>
                    Dashboard
                </a>
            </li>
         
            <li>
                <a asp-controller="Assets" asp-action="Index" class="@(ViewData["ActivePage"]?.ToString() == "Assets" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0v10l-8 4-8-4V7" />
                    </svg>
                    Assets
                </a>
            </li>
            <li>
                <a asp-controller="College" asp-action="Index" class="@(ViewData["ActivePage"]?.ToString() == "Colleges" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M9 21V9m6 12V9M3 9l9-6 9 6" />
                    </svg>
                    Colleges
                </a>
            </li>
            <li>
                <a asp-controller="Locations" asp-action="Index" class="@(ViewData["ActivePage"]?.ToString() == "Locations" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c-4.418 0-8-4.03-8-9a8 8 0 1116 0c0 4.97-3.582 9-8 9z" />
                        <circle cx="12" cy="12" r="2.5" />
                    </svg>
                    Locations
                </a>
            </li>
            <li>
                <a asp-controller="Maintenance" asp-action="Index" class="@(ViewData["ActivePage"]?.ToString() == "Maintenance" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437" />
                    </svg>
                    Maintenance
                </a>
            </li>
            <li>
                <a asp-controller="Reports" asp-action="Index" class="@(ViewData["ActivePage"]?.ToString() == "Reports" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                    </svg>
                    Reports
                </a>
            </li>
            <li>
                <a asp-controller="ManageUsers" asp-action="Index" class="@(ViewData["ActivePage"]?.ToString() == "ManageUsers" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M17 21v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M23 21v-2a4 4 0 00-3-3.87" />
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M16 3.13a4 4 0 010 7.75" />
                    </svg>
                  @*   <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                    </svg> *@
                    Manage Users
                </a>
            </li>

            <li>
                <a asp-controller="Technicians" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Technicians" ? "active" : "")">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437" />
                    </svg>
                    Technicians
                </a>
            </li>
        </ul>

        <!-- Footer -->
        <div class="sidebar-footer">
            <div class="user-card">
                <div class="user-avatar">@initials</div>
                <div class="user-info">
                    <div class="user-name">@FullName</div>
                    <div class="user-role">System Administrator</div>
                </div>
            </div>
        </div>

    </aside>

    <!-- ── Main Layout ── -->
    <div class="layout">

        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-left">
                <span class="text-muted text-sm">UAM</span>
                <span class="breadcrumb-sep">/</span>
                <span class="topbar-page">@ViewData["Title"]</span>
            </div>
            <!-- ── Avatar with dropdown ── -->

            <div class="topbar-right">


            <span class="role-badge">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="width:12px;height:12px">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M9 21V9m6 12V9M3 9l9-6 9 6" />
                </svg>
                @FullName
            </span>
            <div class="avatar-wrap" id="avatarWrap">
                <div class="top-avatar" style="background:#6366f1"
                     onclick="toggleAvatarDropdown()">
                    @initials
                </div>

                <div class="avatar-dropdown" id="avatarDropdown">
                    <div class="ad-header">
                        <div class="ad-name">@FullName</div>
                        <div class="ad-email">@email</div>
                      @*   <div class="ad-college">@collegeName</div> *@
                    </div>
                    <div class="ad-logout-form">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="ad-logout-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
                                </svg>
                                Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            </div>
           @*  <div class="topbar-right">
                <button type="button" onclick="location.href='@Url.Action("Login", "Account")'" class="topbar-icon-btn" title="Notifications">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                    </svg>
                    <span class="notif-dot"></span>
                </button>

                <a asp-controller="Account" asp-action="Login">
                    <div class="top-avatar">AU</div>
                </a>
                <form asp-action="Logout" asp-controller="Account" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="background:none;border:none;cursor:pointer;color:inherit;font:inherit">
                        Logout
                    </button>
                </form>
            </div> *@
        </header>

        <!-- Page Body -->
        <main class="content">
            @RenderBody()
        </main>

    </div><!-- /layout -->

    <script>
            function toggleSidebar() {
              document.getElementById('sidebar').classList.toggle('open');
              document.getElementById('overlay').classList.toggle('show');
            }

              function toggleAvatarDropdown() {
                document.getElementById('avatarDropdown').classList.toggle('open');
            }

            // Close dropdown when clicking anywhere outside
            document.addEventListener('click', function (e) {
                const wrap = document.getElementById('avatarWrap');
                if (wrap && !wrap.contains(e.target)) {
                    document.getElementById('avatarDropdown').classList.remove('open');
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



























