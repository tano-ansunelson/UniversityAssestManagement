@model UniversityAssetsManagement.Models.ViewModels.UploadAssetViewModel
@{
    ViewData["Title"] = "Upload Asset";
    // ViewData["ActivePage"] = "CUpload";
    Layout = "~/Views/Shared/_CollegeLayout.cshtml";
}

<div class="page-header">
  
    <div class="page-title-group">
        <a href="@Url.Action("Index", "CollegeAdmin")"
           style="font-size:13px;color:var(--text-muted);text-decoration:none;
            display:inline-flex;align-items:center;gap:5px;margin-bottom:8px">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Dashboard
        </a>
        <div style="display:flex;align-items:center;gap:10px">
            <div class="stat-icon si-blue" style="width:38px;height:38px;border-radius:10px">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="width:18px;height:18px">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                </svg>
            </div>
            <h1 class="page-title">Upload Asset</h1>
        </div>
        <p class="page-subtitle" style="margin-top:6px">
            Register new assets for your college. Provide details and supporting documentation.
        </p>
    </div>
</div>

<!-- Success banner (shown via TempData) -->
@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        @TempData["Success"]
    </div>
}

<form asp-action="UploadAsset" asp-controller="CollegeAdmin" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <!-- Asset Information -->
    <div class="form-panel">
        <div class="form-panel-header">
            <h2>Asset Information</h2>
            <p>Basic details about the asset</p>
        </div>
        <div class="form-panel-body">
            <div class="form-grid">

                <!-- Asset Name -->
                <div>
                    <label class="field-label">Asset Name <span>*</span></label>
                    <input asp-for="Name" class="field-input"
                           placeholder="e.g., Projector, Microscope" required />
                    <span asp-validation-for="Name" style="font-size:12px;color:var(--rose);display:block;margin-top:4px"></span>
                </div>

                <!-- Asset Type -->
                <div>
                    <label class="field-label">Asset Type <span>*</span></label>
                    <select asp-for="Type" id="assetType" class="field-select">
                        <option value="Unique">Unique</option>
                        <option value="Bulk">Bulk</option>
                    </select>
                </div>

                <!-- Bulk Quantity -->
                <div id="bulkQuantityContainer" style="display:none;">
                    <label class="field-label">Quantity <span>*</span></label>
                    <input 
                        asp-for="Quantity"
                        type="number"
                        
                           min="1"
                           class="field-input"
                           placeholder="Enter quantity" />
                    <span asp-validation-for="Quantity" style="font-size:12px;color:var(--rose);display:block;margin-top:4px"></span>
                </div>

            @*     <!-- Location -->
                <div class="full">
                    <label class="field-label">Location <span>*</span></label>
                     
                    <div class="location-options" style="display:flex;gap:20px;margin-bottom:10px">

                        <label style="font-size:13px;display:flex;align-items:center;gap:6px">
                            <input type="radio"
                                   asp-for="LocationOption"
                                   value="select"                
                                   onchange="toggleLocationInput()">
                            Select existing location
                        </label>

                        <label style="font-size:13px;display:flex;align-items:center;gap:6px">
                            <input type="radio"
                                   asp-for="LocationOption"
                                   value="manual"
                                   onchange="toggleLocationInput()">
                            Enter new location
                        </label>

                    </div>

                    <!-- Dropdown -->
                    <div id="selectLocationDiv">
                        <select asp-for="LocationId" class="field-select">
                            <option value="">— Select location —</option>

                            @foreach( var loc in Model.Locations)
                                    {
                                        <option value="@loc.Id">@loc.Name</option>
                                    }
                                </select>
                        <span asp-validation-for="LocationId" style="font-size:12px;color:var(--rose);display:block;margin-top:4px"></span>
                    </div>

                    <!-- Manual input -->
                    <div id="manualLocationDiv" style="display:none; margin-top:10px;">
                        <input type="text"
                               asp-for="NewLocation"
                               class="field-input"
                               placeholder="Enter location" />
                        <span asp-validation-for="NewLocation" style="font-size:12px;color:var(--rose);display:block;margin-top:4px"></span>
                    </div>
                </div> *@
                <div>
                    <label class="field-label">Location <span>*</span></label>
                    <select name="LocationId" class="field-select">
                        <option value="">— Select location —</option>
                      
                            @foreach (var loc in Model.Locations)
                            {
                                <option value="@loc.Id">@loc.Name</option>
                            }
                        
                    </select>
                </div>

                <!-- Value -->
                <div>
                    <label class="field-label">Estimated Value (GHS)</label>
                    <input asp-for="Value" type="number" step="0.01" min="0"
                           class="field-input" placeholder="0.00" />
                </div>

                <!-- Description (full width) -->
                <div class="full">
                    <label class="field-label">Description</label>
                    <textarea asp-for="Description" class="field-textarea"
                              placeholder="Additional details about the asset..."></textarea>
                </div>

            </div>
        </div>
    </div>

    <!-- Documentation -->
    <div class="form-panel">
        <div class="form-panel-header">
            <h2>Documentation</h2>
            <p>Upload receipts, invoices, or photos</p>
        </div>
        <div class="form-panel-body">
            <div class="drop-zone" onclick="document.getElementById('fileInput').click()">
                <div class="dz-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                </div>
                <div class="dz-title">Click to upload or drag and drop</div>
                <div class="dz-sub">PDF, JPG, PNG, XLSX — max 10MB, up to 5 files</div>
                <input type="file" id="fileInput" name="Files" multiple accept=".pdf,.jpg,.jpeg,.png,.xlsx"
                       style="display:none" onchange="showFileNames(this)" />
            </div>
            <p id="fileNames" style="font-size:12.5px;color:#7a8a9e;margin-top:8px"></p>
        </div>
    </div>

    <!-- Actions -->
    <div style="display:flex;gap:10px">
        <button type="submit" class="btn-submit">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
            Upload Asset
        </button>
        <button type="button"
                class="btn-clear"
                onclick="location.href='@Url.Action("Index","CollegeAdmin")'">
            Cancel
        </button>
    </div>

</form>

@section Scripts {
    <script>
            function showFileNames(input) {
            const names = Array.from(input.files).map(f => f.name).join(', ');
            document.getElementById('fileNames').textContent = names ? `Selected: ${names}` : '';
        }

        document.addEventListener("DOMContentLoaded", function () {
            const assetType = document.getElementById("assetType");
            const quantityContainer = document.getElementById("bulkQuantityContainer");

            function toggleQuantityField() {
                quantityContainer.style.display = assetType.value === "Bulk" ? "block" : "none";
            }

            toggleQuantityField();
            assetType.addEventListener("change", toggleQuantityField);
        });

        function toggleLocationInput() {
            const selected = document.querySelector('input[name="LocationOption"]:checked').value;
            document.getElementById('selectLocationDiv').style.display = selected === 'select' ? 'block' : 'none';
            document.getElementById('manualLocationDiv').style.display = selected === 'manual' ? 'block' : 'none';
        }
    </script>
}
