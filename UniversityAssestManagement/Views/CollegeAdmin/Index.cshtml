@model UniversityAssetsManagement.Models.ViewModels.CollegeDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "CDashboard";
    Layout = "~/Views/Shared/_CollegeLayout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">College Dashboard</h1>
        <p class="page-subtitle">Manage your assets and track submissions.</p>
    </div>

    <button type="button"  class="btn-primary" onclick="location.href='@Url.Action("UploadAsset", "CollegeAdmin")'">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add Asset
    </button>
</div>

<!-- Stat Cards -->
<div class="stats-grid" style="margin-bottom:28px">
    <div class="stat-card c-blue">
        <div class="stat-icon si-blue">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalAssets</div>
            <div class="stat-label">Total Assets Uploaded</div>
        </div>
    </div>

   @*  <div class="stat-card c-gold">
        <div class="stat-icon si-gold">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">3</div>
            <div class="stat-label">Pending Review</div>
        </div>
    </div> *@

    <div class="stat-card c-rose">
        <div class="stat-icon si-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.IssuesReported</div>
            <div class="stat-label">Issues Reported</div>
        </div>
    </div>

    <div class="stat-card c-teal">
        <div class="stat-icon si-teal">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.ResolvedIssues</div>
            <div class="stat-label">Resolved Issues</div>
        </div>
    </div>
</div>

<!-- Recent Submissions -->
<div class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Recent Submissions</div>
            <div class="panel-subtitle">Your latest uploads and reports</div>
        </div>
        <a asp-controller="CollegeAdmin" asp-action="Assets"
           class="btn-ghost" style="width:auto;padding:6px 14px;font-size:12.5px">
            View all
        </a>
    </div>
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach( var asset in Model.RecentSubmissions)
                {
                    var statusClass = asset.Status switch
                    {
                        "Active" => "badge badge-success",
                        "Damaged" => "badge badge-danger",
                        "Under Maintenance"=> "badge badge-warning",
                        "Missing" => "badge badge-primary",
                        "Maintenance Needed" => "badge badge-info",
                        "Malfunction" => "badge badge-warning",
                        _ => "badge badge-secondary"
                    };
                    <tr>
                        <td><span class="type-upload">@asset.Type</span></td>
                        <td class="td-name">@asset.Name</td>
                        <td class="td-muted font-mono" style="font-size:12.5px">@asset.Date.ToString("dd MMM yyyy")</td>
                        <td><span class="@statusClass">@asset.Status</span></td>
                    </tr>
                }
               
               @*  <tr>
                    <td><span class="type-upload">Asset Upload</span></td>
                    <td class="td-name">Microscope Set</td>
                    <td class="td-muted font-mono" style="font-size:12.5px">2024-01-14</td>
                    <td><span class="badge-pending-sub">Pending</span></td>
                </tr>

                <tr>
                    <td><span class="type-issue">Issue Report</span></td>
                    <td class="td-name">Laptop - Lab A not charging</td>
                    <td class="td-muted font-mono" style="font-size:12.5px">2024-01-13</td>
                    <td><span class="badge-resolved">Resolved</span></td>
                </tr>

                <tr>
                    <td><span class="type-upload">Asset Upload</span></td>
                    <td class="td-name">Whiteboard Markers</td>
                    <td class="td-muted font-mono" style="font-size:12.5px">2024-01-12</td>
                    <td><span class="badge-approved">Approved</span></td>
                </tr> *@

            </tbody>
        </table>
    </div>
</div>
