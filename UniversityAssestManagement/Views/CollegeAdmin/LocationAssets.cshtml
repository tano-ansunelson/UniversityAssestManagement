@model UniversityAssetsManagement.Models.ViewModels.LocationAssetsViewModel

@{
    ViewData["Title"] = Model.LocationName;
    ViewData["ActivePage"] = "CLocation";
    Layout = "~/Views/Shared/_CollegeLayout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <a href="@Url.Action("Locations", "CollegeAdmin")"
           style="font-size:13px;color:var(--text-muted);text-decoration:none;
            display:inline-flex;align-items:center;gap:5px;margin-bottom:8px">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Locations
        </a>
        <div style="display:flex;align-items:center;gap:10px">
            <div class="stat-icon si-blue"
                 style="width:38px;height:38px;border-radius:10px">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2" style="width:18px;height:18px">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
            <h1 class="page-title">@Model.LocationName</h1>
        </div>
        <p class="page-subtitle" style="margin-top:6px">
            @Model.CollegeName &bull; @Model.TotalAssets asset(s) in this location
        </p>
    </div>
    <a href="@Url.Action("UploadAsset", "CollegeAdmin")" class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add Asset Here
    </a>
</div>

<!-- Stat Cards -->
<div class="stats-grid" style="margin-bottom:28px">
    <div class="stat-card c-blue">
        <div class="stat-icon si-blue">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M20 7l-8-4-8 4m16 0v10l-8 4-8-4V7" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalAssets</div>
            <div class="stat-label">Total Assets</div>
        </div>
    </div>

    <div class="stat-card c-teal">
        <div class="stat-icon si-teal">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.ActiveAssets</div>
            <div class="stat-label">Active</div>
        </div>
    </div>

    <div class="stat-card c-rose">
        <div class="stat-icon si-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.DamagedAssets</div>
            <div class="stat-label">Damaged</div>
        </div>
    </div>

    <div class="stat-card c-gold">
        <div class="stat-icon si-gold">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalValue.ToString("C")</div>
            <div class="stat-label">Total Value</div>
        </div>
    </div>
</div>

<!-- Assets Table -->
<div class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Assets in @Model.LocationName</div>
            <div class="panel-subtitle">
                @Model.TotalAssets asset(s) assigned to this location
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Asset Name</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Assets.Any())
                {
                    <tr>
                        <td colspan="5"
                            style="text-align:center;padding:40px;color:#7a8a9e">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
                                 style="width:40px;height:40px;margin:0 auto 12px;
                                display:block;opacity:.3">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M20 7l-8-4-8 4m16 0v10l-8 4-8-4V7" />
                            </svg>
                            No assets in this location yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var asset in Model.Assets)
                    {
                        <tr>
                            <td class="td-name">@asset.Name</td>
                            <td>
                                <span class="badge @(asset.Type == "Bulk"
                                                                        ? "badge-warning" : "badge-navy")">
                                    @asset.Type
                                </span>
                            </td>
                            <td style="font-family:'DM Mono',monospace;font-size:13px">
                                @asset.Value.ToString("C")
                            </td>
                            <td>
                                @if (asset.Status == AssetStatus.Active)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else if (asset.Status == AssetStatus.Damaged)
                                {
                                    <span class="badge badge-danger">Damaged</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">
                                        Under Maintenance
                                    </span>
                                }
                            </td>
                            <td>
                                <div style="display:flex;gap:10px">
                                    <a href="@Url.Action("AssetDetails", "CollegeAdmin",
                                                                                      new { id = asset.Id })"
                                       style="font-size:13px;font-weight:600;
                                        color:var(--sky);text-decoration:none">
                                        View
                                    </a>
                                    <a href="@Url.Action("Edit", "CollegeAdmin",
                                                                                      new { id = asset.Id })"
                                       style="font-size:13px;font-weight:600;
                                        color:var(--text-dim);text-decoration:none">
                                        Edit
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer-bar">
        <p>@Model.TotalAssets asset(s) in @Model.LocationName</p>
    </div>
</div>