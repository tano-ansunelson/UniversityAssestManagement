@model UniversityAssetsManagement.Models.ViewModels.AssetsDetailsViewModel

@{
    ViewData["Title"] = "Delete Asset";
    ViewData["ActivePage"] = "SAsset";
    Layout = "~/Views/Shared/_CollegeLayout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Delete Asset</h1>
        <p class="page-subtitle">This action cannot be undone.</p>
    </div>
</div>

<div class="panel" style="max-width:520px">
    <div style="padding:28px">

        <div style="display:flex;align-items:flex-start;gap:14px;
            padding:16px;background:rgba(224,92,107,.06);
            border:1.5px solid rgba(224,92,107,.2);
            border-radius:var(--radius-md);margin-bottom:24px">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2"
                 style="width:20px;height:20px;color:var(--rose);flex-shrink:0">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            <div>
                <p style="font-size:14px;font-weight:600;color:var(--navy)">
                    Are you sure you want to delete this asset?
                </p>
                <p style="font-size:13px;color:#7a8a9e;margin-top:4px">
                    All maintenance history for this asset will also be permanently removed.
                </p>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:0">
            <div style="display:flex;justify-content:space-between;
                padding:11px 0;border-bottom:1px solid var(--cream-2)">
                <span style="font-size:13px;color:#7a8a9e">Asset Name</span>
                <span style="font-size:13.5px;font-weight:600;color:var(--navy)">@Model.Name</span>
            </div>
            <div style="display:flex;justify-content:space-between;
                padding:11px 0;border-bottom:1px solid var(--cream-2)">
                <span style="font-size:13px;color:#7a8a9e">Type</span>
                <span style="font-size:13.5px;color:var(--navy)">@Model.Type</span>
            </div>
            <div style="display:flex;justify-content:space-between;
                padding:11px 0;border-bottom:1px solid var(--cream-2)">
                <span style="font-size:13px;color:#7a8a9e">Location</span>
                <span style="font-size:13.5px;color:var(--navy)">@Model.LocationName</span>
            </div>
            <div style="display:flex;justify-content:space-between;padding:11px 0">
                <span style="font-size:13px;color:#7a8a9e">Value</span>
                <span style="font-size:13.5px;font-weight:600;
                    font-family:'DM Mono',monospace;color:var(--navy)">
                    @Model.Value.ToString("C")
                </span>
            </div>
        </div>

        <form asp-action="Delete" asp-controller="CollegeAdmin" method="post" style="margin-top:24px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div style="display:flex;gap:10px">
                <button type="submit" class="btn-submit btn-submit-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                    </svg>
                    Yes, Delete Asset
                </button>
                <a href="@Url.Action("Assets", "CollegeAdmin", new { id = Model.Id })"
                   class="btn-clear">Cancel</a>
            </div>
        </form>

    </div>
</div>