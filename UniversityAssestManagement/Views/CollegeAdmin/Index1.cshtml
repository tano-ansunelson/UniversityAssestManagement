@model List<UniversityAssestManagement.Models.Location>

@{
    ViewData["Title"] = "Locations";
    ViewData["ActivePage"] = "CLocation";
    Layout = "~/Views/Shared/_CollegeLayout.cshtml";
}

<style>

</style>

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <div style="display:flex;align-items:center;gap:10px">
            <div class="stat-icon si-blue" style="width:38px;height:38px;border-radius:10px">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2" style="width:18px;height:18px">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
            <h1 class="page-title">Locations</h1>
        </div>
        <p class="page-subtitle" style="margin-top:6px">
            @ViewBag.CollegeName &bull; @Model.Count location(s)
        </p>
    </div>
    <button class="btn-primary" onclick="openModal()">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add Location
    </button>
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert-success" style="margin-bottom:20px">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="display:flex;align-items:center;gap:8px;padding:12px 16px;
        background:rgba(224,92,107,.08);border:1.5px solid rgba(224,92,107,.2);
        border-radius:var(--radius-sm);margin-bottom:20px;
        font-size:13.5px;color:var(--rose)">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2" style="width:16px;height:16px;flex-shrink:0">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
        @TempData["Error"]
    </div>
}

<!-- Locations Grid -->
@if (!Model.Any())
{
    <div class="panel">
        <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1.5" display="block" margin="0 auto">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <strong style="font-size:15px;color:var(--navy)">No locations yet</strong>
            <p>Click "Add Location" to create your first location.</p>
        </div>
    </div>
}
else
{
    <div class="locations-grid">
        @foreach (var location in Model)
        {
            <div class="location-card">
                <div class="lc-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0L6.343 16.657a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <div>
                    <div class="lc-name">@location.Name</div>
                    <div class="lc-count">
                        @location.Assets.Count asset@(location.Assets.Count == 1 ? "" : "s")
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ── Add Location Modal ── -->
<div class="modal-overlay" id="locationModal" onclick="handleOverlayClick(event)">
    <div class="modal-box">

        <div class="modal-header">
            <h3>Add New Location</h3>
            <button type="button" class="modal-close" onclick="closeModal()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form asp-action="AddLocation" asp-controller="CollegeAdmin" method="post">
            @Html.AntiForgeryToken()

            <div class="modal-body">
                <label class="field-label">
                    Location Name <span style="color:var(--rose)">*</span>
                </label>
                <input type="text"
                       name="name"
                       id="locationNameInput"
                       class="field-input"
                       placeholder="e.g. Computer Lab A, Physics Block, Room 201"
                       required
                       autocomplete="off" />
                <p style="font-size:12px;color:#7a8a9e;margin-top:8px">
                    This location will only be visible within @ViewBag.CollegeName.
                </p>
            </div>

            <div class="modal-footer">
                <button type="submit" class="btn-submit">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                    Add Location
                </button>
                <button type="button" class="btn-clear" onclick="closeModal()">Cancel</button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        function openModal() {
            document.getElementById('locationModal').classList.add('open');
            // Focus the input automatically
            setTimeout(() => document.getElementById('locationNameInput').focus(), 100);
        }

        function closeModal() {
            document.getElementById('locationModal').classList.remove('open');
            document.getElementById('locationNameInput').value = '';
        }

        // Close when clicking the dark backdrop but not the box itself
        function handleOverlayClick(e) {
            if (e.target === document.getElementById('locationModal')) closeModal();
        }

        // Close on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeModal();
        });

        // Auto-open modal if there was an error (so user doesn't have to click again)
        @if (TempData["Error"] != null)
            {
                <text>openModal();</text>
        }
    </script>
}