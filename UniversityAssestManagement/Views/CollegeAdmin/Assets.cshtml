@model UniversityAssetsManagement.Models.ViewModels.AssetCollegeViewModel

@{
    ViewData["Title"] = "Asesets";
    ViewData["ActivePage"] = "SAssets";
    Layout = "~/Views/Shared/_CollegeLayout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Assets</h1>
        <p class="page-subtitle">Manage all university assets across colleges.</p>
    </div>
 
    <button type="button" class="btn-primary" onclick="location.href='@Url.Action("UploadAsset", "CollegeAdmin")'">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add Asset
    </button>
</div>


<!-- Assets Table -->
<div class="panel">
    <div class="overflow-x-auto">
        <table class="data-table" id="assetsTable">
            <thead>
                <tr>
                    <th>Asset Name</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>

                @if (!Model.CollegeAssets.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted)">
                            No assets uploaded yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var asset in Model.CollegeAssets)
                    {
                        var statusClass = asset.Status switch
                        {
                            "Active" => "badge badge-success",
                            "Damaged" => "badge badge-danger",
                            "Missing" => "badge badge-primary",
                            "Maintenance Needed"=> "badge badge-info",
                            "Under Maintenance" => "badge badge-warning",
                            "Malfunction" => "badge badge-warning",
                            _ => "badge badge-secondary"
                        };

                        <tr>
                            <td class="td-name">@asset.Name</td>
                            <td>
                                <span class="badge @(asset.Type== "Bulk"? "badge-warning": "badge-navy")">

                                @asset.Type
                                 </span>
                              </td>

                            <td class="td-muted"> @asset.Value</td>
                            <td class="td-muted">@asset.LocationName</td>
                            <td>
                                <span class="@statusClass">@asset.Status</span>
                           

                                                           
                            </td>
                            <td>
                                <div style="display:flex;gap:10px">
                                    <a href="@Url.Action("AssetDetails", "CollegeAdmin", new {id=asset.Id} )" style="font-size:13px;font-weight:600;color:var(--sky);text-decoration:none;">View</a>
                                    <a href="@Url.Action("Edit", "CollegeAdmin", new {id =asset.Id})" style="font-size:13px;font-weight:600;color:var(--text-dim);text-decoration:none;">Edit</a>
                                  
                                
                                    <!-- Triggers delete modal instead of navigating -->
                                    <button onclick="openDeleteModal(@asset.Id, '@asset.Name')"
                                            style="font-size:13px;font-weight:600;
                                        color:var(--rose);background:none;
                                        border:none;cursor:pointer;padding:0;
                                        font-family:'DM Sans',sans-serif">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>

                    }
                }

              
        
            </tbody>
        </table>

    </div>
    <div class="table-footer-bar">
        <p style="font-size:12.5px;color:#7a8a9e;margin:0">
            @Model.CollegeAssets.Count asset(s)
        </p>
       @*  <p id="countLabel">Showing 10 of 10 assets</p> *@
    </div>
</div>
@* 
<!-- Delete Confirmation Modal --> *@
<div class="modal-overlay" id="deleteModal" onclick="handleOverlayClick(event)">
    <div class="modal-box">

        <div class="modal-header">
            <h3>Delete Asset</h3>
            <button type="button" class="modal-close" onclick="closeDeleteModal()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="modal-body">
            <!-- Warning banner -->
            <div style="display:flex;align-items:flex-start;gap:12px;
                padding:14px;
                background:rgba(224,92,107,.06);
                border:1.5px solid rgba(224,92,107,.2);
                border-radius:var(--radius-sm);
                margin-bottom:18px">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2"
                     style="width:18px;height:18px;color:var(--rose);flex-shrink:0;margin-top:1px">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
                <div>
                    <p style="font-size:13.5px;font-weight:600;color:var(--navy);margin:0">
                        This action cannot be undone.
                    </p>
                    <p style="font-size:12.5px;color:#7a8a9e;margin-top:3px">
                        All maintenance records for this asset will also be permanently deleted.
                    </p>
                </div>
            </div>

            <!-- Asset name confirmation -->
            <p style="font-size:13px;color:#7a8a9e;margin-bottom:6px">You are about to delete:</p>
            <p id="deleteAssetName"
               style="font-size:15px;font-weight:700;color:var(--navy);
                padding:10px 14px;background:var(--cream);
                border-radius:var(--radius-sm);margin:0">
            </p>
        </div>

        <div class="modal-footer">
            <form id="deleteForm" asp-action="Delete" asp-controller="CollegeAdmin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteAssetId" name="id" />
                <div style="display:flex;gap:10px">
                    <button type="submit" class="btn-submit btn-submit-danger">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                        </svg>
                        Yes, Delete
                    </button>
                    <button type="button" class="btn-clear" onclick="closeDeleteModal()">
                        Cancel
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>



@section Scripts {
    <script>
        // ── Delete modal ─────────────────────────────────────────────────
        function openDeleteModal(id, name) {
            document.getElementById('deleteAssetId').value  = id;
            document.getElementById('deleteAssetName').textContent = name;
            document.getElementById('deleteModal').classList.add('open');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('open');
        }

        function handleOverlayClick(e) {
            if (e.target === document.getElementById('deleteModal')) closeDeleteModal();
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeDeleteModal();
        });
    </script>
}