@model UniversityAssetsManagement.Models.ViewModels.MySubmissionsViewModel
@{
    ViewData["Title"] = "My Submissions";
    ViewData["ActivePage"] = "CSubmissions";
    Layout = "~/Views/Shared/_CollegeLayout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <div style="display:flex;align-items:center;gap:10px">
            <div class="stat-icon si-blue" style="width:38px;height:38px;border-radius:10px">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="width:18px;height:18px">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
                </svg>
            </div>
            <h1 class="page-title">My Submissions</h1>
        </div>
        <p class="page-subtitle" style="margin-top:6px">
            Track the status of all your asset uploads and issue reports.
        </p>
    </div>
</div>

<!-- Stat Cards -->
<div class="stats-grid" style="margin-bottom:28px">
    <div class="stat-card c-blue">
        <div class="stat-icon si-blue">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalAssets</div>
            <div class="stat-label">Total</div>
        </div>
    </div>

     <div class="stat-card c-gold">
        <div class="stat-icon si-gold">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.PendingAssets</div>
            <div class="stat-label">Pending Review</div>
        </div>
    </div>

    <div class="stat-card c-rose">
        <div class="stat-icon si-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.UnderMaintenanceCount</div>
            <div class="stat-label">Under Maintenance</div>
        </div>
    </div>

  
</div>



<!-- Submissions Table -->
<div class="panel" style="margin-bottom:22px">
    <div class="panel-header">
        <div>
            <div class="panel-title">Submission History</div>
            <div class="panel-subtitle">All your asset uploads and issue reports</div>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>

                    <th>Type</th>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Issue</th>
                </tr>
            </thead>
            <tbody>
                @foreach( var ass in Model.Issues)
                {
                    <tr>
                        @* <td class="font-mono" style="font-size:12.5px;color:#7a8a9e">@ass.Id</td> *@
                       @*  <td><span class="type-upload">@ass.Type</span></td> *@
                        <td><span class="badge badge-danger">@ass.Type</span></td>
                        <td class="td-name">@ass.Name</td>
                        <td class="td-muted font-mono" style="font-size:12.5px">@ass.Date.ToString("dd MMM yyyy")</td>
                        <td><span class="badge-approved">@ass.Status</span></td>
                        <td>
                            <span class="badge-warning">@ass.IssueType</span>
                          @*  <div style="display:flex;gap:6px">
                                <button class="topbar-icon-btn" title="View Details">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                </button>
                                <button class="topbar-icon-btn" title="Download">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                                </button>
                            </div> *@

                        </td>
                    </tr>
                }
              
         
            </tbody>
        </table>
    </div>
</div>

