@model UniversityAssestManagement.Models.ViewModels.LocationViewModel
@{
    ViewData["Title"] = "Locations";
    ViewData["ActivePage"] = "Locations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Locations</h1>
        <p class="page-subtitle">All asset locations grouped by college.</p>
    </div>
</div>

@if (!Model.Groups.Any())
{
<div class="panel" style="padding:40px;text-align:center;color:var(--text-muted)">
    No locations found
    
</div>
}
else
{
    @foreach(var group in Model.Groups)
    {
        <!-- College of Engineering -->
        <div class="group-section">
            <div class="group-section-header">
                <span class="gs-code">@group.CollegeCode</span>
                <span class="gs-name">@group.CollegeName</span>
                <span class="gs-meta">
                    @group.Locations.Count location@(group.Locations.Count == 1 ? "" : "s")
                    &bull;
                    @group.TotalAssets asset@(group.TotalAssets == 1 ? "" : "s")
                  @*   5 locations &bull; 281 assets *@
                    
                </span>
            </div>

            @if (!group.Locations.Any())
            {
                <p style="padding:16px 24px;color:var(--text-muted);font-size:13px">
                    No locations added yet.
                </p>
            }
            else
            {
                <div class="location-grid">
                    @foreach (var location in group.Locations)
                    {
                        <div class="location-pill">
                            <div class="loc-dot">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21c-4.418 0-8-4.03-8-9a8 8 0 1116 0c0 4.97-3.582 9-8 9z" /><circle cx="12" cy="12" r="2.5" /></svg>
                            </div>
                            <div>
                                <div class="loc-name">@location.Name</div>
                                <div class="loc-count">@location.AssetCount asset@(location.AssetCount == 1 ? "" : "s")</div>
                            </div>
                        </div>
                    }

               
                </div>
            }


          
        </div>
    }
   
}





@section Scripts {
    <script>
        // Animate cards in on load
        document.querySelectorAll('.location-grid').forEach((card, i) => {
          card.style.opacity = '0';
          card.style.transform = 'translateY(16px)';
          card.style.transition = `opacity .35s ease ${i * 60}ms, transform .35s ease ${i * 60}ms`;
          requestAnimationFrame(() => {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          });
        });
    </script>
}
