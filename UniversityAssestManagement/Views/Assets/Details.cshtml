@model UniversityAssestManagement.Models.ViewModels.AssetDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    ViewData["ActivePage"] = "Assets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a href="@Url.Action("Index", "Assets")"
           style="font-size:13px;color:var(--text-muted);text-decoration:none;
            display:inline-flex;align-items:center;gap:5px;margin-bottom:8px">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Assets
        </a>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">
            @Model.CollegeName &bull; @Model.LocationName
        </p>
    </div>
   @*  <a href="@Url.Action("Edit", "Assets", new { id = Model.Id })" class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
        </svg>
        Edit Asset
    </a> *@
</div>

<!-- Stat Cards -->
<div class="stats-grid" style="margin-bottom:28px">

    <div class="stat-card c-blue">
        <div class="stat-icon si-blue">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M20 7l-8-4-8 4m16 0v10l-8 4-8-4V7" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.Type</div>
            <div class="stat-label">Asset Type</div>
        </div>
    </div>

    <div class="stat-card @(Model.Status == "Active" ? "c-teal" : Model.Status == "Damaged" ? "c-rose" : "c-gold")">
        <div class="stat-icon @(Model.Status == "Active" ? "si-teal" : Model.Status == "Damaged" ? "si-rose" : "si-gold")">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.Status</div>
            <div class="stat-label">Current Status</div>
        </div>
    </div>

    <div class="stat-card c-gold">
        <div class="stat-icon si-gold">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.Value.ToString("C")</div>
            <div class="stat-label">Asset Value</div>
        </div>
    </div>

    <div class="stat-card c-rose">
        <div class="stat-icon si-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalRepairCost.ToString("C")</div>
            <div class="stat-label">Total Repair Cost</div>
            <div class="stat-meta">@Model.TotalMaintenance maintenance(s)</div>
        </div>
    </div>

</div>

<!-- Details + Maintenance history -->
<div class="grid-2">

    <!-- Asset Info -->
    <div class="panel">
        <div class="panel-header">
            <div>
                <div class="panel-title">Asset Information</div>
                <div class="panel-subtitle">Full details for this asset</div>
            </div>
        </div>
        <div style="padding:24px;display:flex;flex-direction:column;gap:18px">

            <div style="display:flex;justify-content:space-between;
                padding-bottom:14px;border-bottom:1px solid var(--cream-2)">
                <span style="font-size:13px;color:#7a8a9e">Asset Name</span>
                <span style="font-size:13.5px;font-weight:600;color:var(--navy)">@Model.Name</span>
            </div>

            <div style="display:flex;justify-content:space-between;
                padding-bottom:14px;border-bottom:1px solid var(--cream-2)">
                <span style="font-size:13px;color:#7a8a9e">Type</span>
                <span class="badge @(Model.Type == "Bulk" ? "badge-warning" : "badge-navy")">
                    @Model.Type
                </span>
            </div>

            <div style="display:flex;justify-content:space-between;
                padding-bottom:14px;border-bottom:1px solid var(--cream-2)">
                <span style="font-size:13px;color:#7a8a9e">Status</span>
                <span class="badge
                    @(Model.Status == "Active" ? "badge-success" :
                        Model.Status == "Damaged" ? "badge-danger" : "badge-warning")">
                    @Model.Status
                </span>
            </div>

            <div style="display:flex;justify-content:space-between;
                padding-bottom:14px;border-bottom:1px solid var(--cream-2)">
                <span style="font-size:13px;color:#7a8a9e">College</span>
                <div style="display:flex;align-items:center;gap:8px">
                    <div class="college-card-top @Model.ColorClass"
                         style="width:10px;height:10px;border-radius:50%;flex-shrink:0"></div>
                    <span style="font-size:13.5px;font-weight:500;color:var(--navy)">
                        @Model.CollegeName
                    </span>
                </div>
            </div>

            <div style="display:flex;justify-content:space-between;
                padding-bottom:14px;border-bottom:1px solid var(--cream-2)">
                <span style="font-size:13px;color:#7a8a9e">Location</span>
                <span style="font-size:13.5px;font-weight:500;color:var(--navy)">
                    @Model.LocationName
                </span>
            </div>

            <div style="display:flex;justify-content:space-between;
                padding-bottom:14px;border-bottom:1px solid var(--cream-2)">
                <span style="font-size:13px;color:#7a8a9e">Value</span>
                <span style="font-size:13.5px;font-weight:600;
                    font-family:'DM Mono',monospace;color:var(--navy)">
                    @Model.Value.ToString("C")
                </span>
            </div>

            <div style="display:flex;justify-content:space-between">
                <span style="font-size:13px;color:#7a8a9e">Date Added</span>
                <span style="font-size:13px;font-family:'DM Mono',monospace;color:#7a8a9e">
                    @Model.CreatedAt.ToString("dd MMM yyyy")
                </span>
            </div>

        </div>
    </div>

    <!-- Maintenance History -->
    <div class="panel">
        <div class="panel-header">
            <div>
                <div class="panel-title">Maintenance History</div>
                <div class="panel-subtitle">
                    @Model.TotalMaintenance record(s) —
                    total cost @Model.TotalRepairCost.ToString("C")
                </div>
            </div>
        </div>

        @if (!Model.MaintenanceRecords.Any())
        {
            <div style="padding:40px;text-align:center;color:#7a8a9e;font-size:13.5px">
                No maintenance records for this asset.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Issue</th>
                            <th>Cost</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.MaintenanceRecords)
                        {
                            <tr>
                                <td class="td-name">@record.IssueDescription</td>
                                <td style="font-family:'DM Mono',monospace;font-size:13px">
                                    @record.Cost.ToString("C")
                                </td>
                                <td>
                                    <span class="badge @(record.Status == "Fixed"
                                                                                  ? "badge-success" : "badge-warning")">
                                        @record.Status
                                    </span>
                                </td>
                                <td class="td-muted font-mono" style="font-size:12.5px">
                                    @record.Date.ToString("yyyy-MM-dd")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>