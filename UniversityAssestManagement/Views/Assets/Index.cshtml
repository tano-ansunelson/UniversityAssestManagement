@model UniversityAssestManagement.Models.ViewModels.AssetsViewModel
@{
    ViewData["Title"] = "Assets";
    ViewData["ActivePage"] = "Assets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Assets</h1>
        <p class="page-subtitle">Manage all university assets across colleges.</p>
    </div>
  @*   <button class="btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add Asset
    </button> *@
</div>

<!-- Search & Filter Bar -->
<form id="searchForm" method="get" asp-action="Index"
      style="display:flex;align-items:center;gap:12px;margin-bottom:22px;flex-wrap:wrap;">

    <div class="search-field" style="flex:1;max-width:380px">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 15.803a7.5 7.5 0 0010.607 0z" />
        </svg>

        <input type="text"
               id="searchInput"
               name="term"
               value="@Model.SearchTerm"
               placeholder="Search by name, college or location…" />
    </div>

    <select name="status"
            style="padding:9px 14px;border:1.5px solid var(--border-light);border-radius:var(--radius-sm);font-size:13.5px;font-family:'DM Sans',sans-serif;background:#fff;color:var(--navy);outline:none;cursor:pointer;">

        <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">
            All Statuses
        </option>

        <option value="Active" selected="@(Model.Status == "Active")">
            Active
        </option>

        <option value="Damaged" selected="@(Model.Status == "Damaged")">
            Damaged
        </option>

        <option value="Under Maintenance" selected="@(Model.Status == "Under Maintenance")">
            Under Maintenance
        </option>

    </select>

    <select name="type"
            style="padding:9px 14px;border:1.5px solid var(--border-light);border-radius:var(--radius-sm);font-size:13.5px;font-family:'DM Sans',sans-serif;background:#fff;color:var(--navy);outline:none;cursor:pointer;">

        <option value="" selected="@(string.IsNullOrEmpty(Model.Type))">
            All Types
        </option>

        <option value="Unique" selected="@(Model.Type == "Unique")">
            Unique
        </option>

        <option value="Bulk" selected="@(Model.Type == "Bulk")">
            Bulk
        </option>

    </select>

</form>

<!-- Assets Table -->
<div class="panel">
    <div class="overflow-x-auto">
        <table class="data-table" id="assetsTable">
            <thead>
                <tr>
                    <th>Asset Name</th>
                    <th>Type</th>
                    <th>College</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach(var asset in Model.Assets)
                {

                    var typeClass = asset.Type switch
                    {
                        "Unique" => "badge badge-navy",
                        "Bulk" => "badge badge-warning",
                       
                        _ => "badge"
                    };
                    var statusClass = asset.Status switch
                    {
                        "Active" => "badge badge-success",
                        "Damaged" => "badge badge-danger",
                        "Under Maintenance" => "badge badge-warning",
                        _ => "badge"
                    };


                    <tr>
                        <td class="td-name">@asset.Name</td>
                        <td><span class="@typeClass">@asset.Type</span></td>
                        <td class="td-muted">@asset.College.Name</td>
                        <td class="td-muted">@asset.Location.Name</td>
                        <td><span class="@statusClass"> @asset.Status</span></td>
                        <td>
                            <div style="display:flex;gap:10px">
                                <a href="@Url.Action("Details", "Assets", new {id =asset.Id})" style="font-size:13px;font-weight:600;color:var(--sky);text-decoration:none;">View</a>
                               @*  <a href="#" style="font-size:13px;font-weight:600;color:var(--text-dim);text-decoration:none;">Edit</a> *@
                            </div>
                        </td>
                    </tr>
                }
               

            </tbody>
        </table>
    </div>
    <div class="table-footer-bar">

        <p>
            Showing @Model.Assets.Count of @Model.FilteredCount assets
        </p>

        <div class="pagination">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-term="@Model.SearchTerm"
                   asp-route-status="@Model.Status"
                   asp-route-type="@Model.Type">
                    Previous
                </a>
            }

            <span>
                @Model.CurrentPage / @Model.TotalPages
            </span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-term="@Model.SearchTerm"
                   asp-route-status="@Model.Status"
                   asp-route-type="@Model.Type">
                    Next
                </a>
            }
        </div>

    </div>
    
</div>

@section Scripts {
    <script>
            let timer;

        document.getElementById("searchInput")
            .addEventListener("input", function () {

                clearTimeout(timer);

                timer = setTimeout(() => {
                    document.getElementById("searchForm").submit();
                }, 2000);
            });

        document.querySelectorAll("#searchForm select")
            .forEach(select => {
                select.addEventListener("change", () => {
                    document.getElementById("searchForm").submit();
                });
            });
    </script>
}
