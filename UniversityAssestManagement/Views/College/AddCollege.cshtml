@model UniversityAssestManagement.Models.ViewModels.AddCollegeViewModel

@{
    ViewData["Title"] = "Add College";
    ViewData["ActivePage"] = "Colleges";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <div class="page-title-group">
        <a href="@Url.Action("Index", "College")"
           style="font-size:13px;color:var(--text-muted);text-decoration:none;
            display:inline-flex;align-items:center;gap:5px;margin-bottom:8px">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Colleges
        </a>
        <h1 class="page-title">Add College</h1>
        <p class="page-subtitle">Register a new college into the system.</p>
    </div>
</div>

<form asp-action="AddCollege" asp-controller="College" method="post"
      style="max-width:620px">
    @Html.AntiForgeryToken()

    <div class="form-panel">
        <div class="form-panel-header">
            <h2>College Information</h2>
            <p>Provide the details for the new college.</p>
        </div>
        <div class="form-panel-body">
            <div class="form-grid">

                <!-- Name -->
                <div class="full">
                    <label class="field-label">
                        College Name <span style="color:var(--rose)">*</span>
                    </label>
                    <input asp-for="Name" class="field-input"
                           placeholder="e.g. College of Engineering" />
                    <span asp-validation-for="Name"
                          style="font-size:12px;color:var(--rose);display:block;margin-top:4px"></span>
                </div>

                <!-- Code -->
                <div>
                    <label class="field-label">
                        College Code <span style="color:var(--rose)">*</span>
                    </label>
                    <input asp-for="Code" class="field-input"
                           placeholder="e.g. COE" style="text-transform:uppercase" />
                    <span asp-validation-for="Code"
                          style="font-size:12px;color:var(--rose);display:block;margin-top:4px"></span>
                </div>

                <!-- Color Theme -->
                <div>
                    <label class="field-label">
                        Color Theme <span style="color:var(--rose)">*</span>
                    </label>
                    <select asp-for="ColorClass" class="field-select"
                            onchange="updatePreview(this.value)">
                        <option value="">— Select a color —</option>
                        <option value="stripe-blue">Blue</option>
                        <option value="stripe-cyan">Cyan</option>
                        <option value="stripe-yellow">Yellow</option>
                        <option value="stripe-red">Red</option>
                        <option value="stripe-green">Green</option>
                        <option value="stripe-purple">Purple</option>
                    </select>
                    <span asp-validation-for="ColorClass"
                          style="font-size:12px;color:var(--rose);display:block;margin-top:4px"></span>
                </div>

                <!-- Description -->
                <div class="full">
                    <label class="field-label">
                        Description <span style="color:var(--rose)">*</span>
                    </label>
                    <textarea asp-for="Description" class="field-textarea"
                              placeholder="e.g. Engineering and Technology programs"></textarea>
                    <span asp-validation-for="Description"
                          style="font-size:12px;color:var(--rose);display:block;margin-top:4px"></span>
                </div>

                <!-- Color preview -->
                <div class="full">
                    <label class="field-label">Preview</label>
                    <div style="background:#fff;border:1px solid var(--border-light);
                        border-radius:var(--radius-md);overflow:hidden;
                        box-shadow:var(--shadow-card)">
                        <div id="colorPreview"
                             style="height:8px;background:var(--cream-2);
                            transition:background .2s">
                        </div>
                        <div style="padding:14px 16px">
                            <span style="font-size:13px;color:#7a8a9e">
                                This is how the college card will look.
                            </span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div style="display:flex;gap:10px">
        <button type="submit" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M3 21h18M9 21V9m6 12V9M3 9l9-6 9 6" />
            </svg>
            Add College
        </button>
        <a href="@Url.Action("Index", "College")" class="btn-ghost"
           style="width:auto;padding:10px 20px">
            Cancel
        </a>
    </div>

</form>

@section Scripts {
    <script>
        const colorMap = {
            'stripe-blue':   '#3b82f6',
            'stripe-cyan':   '#06b6d4',
            'stripe-yellow': '#eab308',
            'stripe-red':    '#ef4444',
            'stripe-green':  '#22c55e',
            'stripe-purple': '#a855f7',
        };

        function updatePreview(val) {
            const preview = document.getElementById('colorPreview');
            preview.style.background = colorMap[val] || 'var(--cream-2)';
        }

        // Force code to uppercase as user types
        document.querySelector('input[name="Code"]')
            .addEventListener('input', function () {
                this.value = this.value.toUpperCase();
            });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}