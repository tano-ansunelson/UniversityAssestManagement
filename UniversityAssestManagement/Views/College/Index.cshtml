@model UniversityAssestManagement.Models.ViewModels.CollegeViewModel

@{
    ViewData["Title"] = "Colleges";
    ViewData["ActivePage"] = "Colleges";
   
}

<div class="page-header">
    <div class="page-title-group">
        <h1 class="page-title">Colleges</h1>
        <p class="page-subtitle">Manage and view all university colleges and their asset counts.</p>
    </div>

    <button type="button" class="btn-primary"
            onclick="location.href='@Url.Action("AddCollege", "College")'">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Add College
    </button>
</div>

<div class="college-grid">
    @foreach( var college in Model.Colleges)
    {      
   
        <!-- College of Engineering -->
        <div class="college-card">
           
            <div class="college-card-top @college.ColorClass"></div>
            <div class="college-card-body">
                <span class="college-code">@college.Code</span>
                <h3 class="college-name">@college.Name</h3>
                <p class="college-desc">@college.Description</p>
                <div class="college-stats">
                    <div class="college-stat-item">
                        <div class="cs-icon cs-icon-blue">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0v10l-8 4-8-4V7" /></svg>
                        </div>
                        <div><div class="cs-val">@college.AssetCount</div><div class="cs-lbl">Assets</div></div>
                    </div>
                    <div class="college-stat-item">
                        <div class="cs-icon cs-icon-teal">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                        </div>
                        <div><div class="cs-val">@college.LocationCount</div><div class="cs-lbl">Locations</div></div>
                    </div>
                </div>
                @* <div class="college-stats">
                    <div class="college-stat-item">
                        <a href="@Url.Action("Details", "College", new { id = college.Id })" class="btn-ghost">View Details</a>

                       </div>
                        
                    <div class="college-stat-item">
                        <a href="@Url.Action("Details", "College", new { id = college.Id })" class="btn-ghost">View Details</a>

                    </div>
                  </div> *@
                <a href="@Url.Action("Details", "College", new{ id =college.Id})" class="btn-ghost">View Details</a>
               
            </div>
        </div>
    }

 

</div>

@section Scripts {
    <script>
        // Animate cards in on load
        document.querySelectorAll('.college-card').forEach((card, i) => {
          card.style.opacity = '0';
          card.style.transform = 'translateY(16px)';
          card.style.transition = `opacity .35s ease ${i * 60}ms, transform .35s ease ${i * 60}ms`;
          requestAnimationFrame(() => {
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          });
        });
    </script>
}
