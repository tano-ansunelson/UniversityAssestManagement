@model UniversityAssestManagement.Models.ViewModels.CollegeDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    ViewData["ActivePage"] = "Colleges";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-title-group">
        <a href="@Url.Action("Index", "College")"
           style="font-size:13px;color:var(--text-muted);text-decoration:none;display:inline-flex;align-items:center;gap:5px;margin-bottom:8px">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="width:14px;height:14px">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Colleges
        </a>
        <div style="display:flex;align-items:center;gap:12px">
            <div class="college-card-top @Model.ColorClass"
                 style="width:6px;height:40px;border-radius:4px;flex-shrink:0"></div>
            <div>
                <h1 class="page-title">@Model.Name</h1>
                <p class="page-subtitle">@Model.Description</p>
            </div>
        </div>
    </div>
    <span class="college-code" style="font-size:14px;padding:6px 14px">@Model.Code</span>
</div>

<!-- Stat Cards -->
<div class="stats-grid" style="margin-bottom:28px">
    <div class="stat-card c-blue">
        <div class="stat-icon si-blue">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0v10l-8 4-8-4V7" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalAssest</div>
            <div class="stat-label">Total Assets</div>
        </div>
    </div>

    <div class="stat-card c-teal">
        <div class="stat-icon si-teal">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.ActiveAssests</div>
            <div class="stat-label">Active Assets</div>
        </div>
    </div>

    <div class="stat-card c-rose">
        <div class="stat-icon si-rose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.DamagedAssets</div>
            <div class="stat-label">Damaged</div>
        </div>
    </div>

    <div class="stat-card c-gold">
        <div class="stat-icon si-gold">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <div class="stat-body">
            <div class="stat-val">@Model.TotalValue.ToString("C")</div>
            <div class="stat-label">Total Value</div>
        </div>
    </div>
</div>

<!-- Assets Table -->
<div class="panel">
    <div class="panel-header">
        <div>
            <div class="panel-title">Assets in @Model.Name.Replace("College of ", "")</div>
            <div class="panel-subtitle">@Model.TotalAssest assets across @Model.TotalLocations locations</div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Asset Name</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th>Value</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.AssestAssets.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted)">
                            No assets found for this college.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var asset in Model.AssestAssets)
                    {
                        <tr>
                            <td class="td-name">@asset.Name</td>
                            <td>
                                <span class="badge @(asset.Type == AssetType.Bulk ? "badge-warning" : "badge-navy")">
                                    @asset.Type
                                </span>
                            </td>
                            <td class="td-muted">@asset.LocationName</td>
                            <td style="font-family:'DM Mono',monospace;font-size:13px">
                                @asset.Value.ToString("C")
                            </td>
                            <td>
                                @if (asset.Status == AssetStatus.Active)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else if (asset.Status == AssetStatus.Damaged)
                                {
                                    <span class="badge badge-danger">Damaged</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Under Maintenance</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3">Total</td>
                    <td style="font-family:'DM Mono',monospace;font-size:13px">
                        @Model.TotalValue.ToString("C")
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="table-footer-bar">
        <p>Showing @Model.AssestAssets.Count assets</p>
    </div>
</div>